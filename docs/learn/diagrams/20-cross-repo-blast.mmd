        S2_HIT["S2 真命中 (path末段=method名 lesson):<br/>cses: triggerLoadIncrement<br/>mm: csesCrossRepoDemo"]:::hit
        MR_BIDIR["✅ 双向真发 MR<br/>cses: !45 / !47 / !48<br/>mm:  !9 / !10 / !11"]:::live
    end

    %% cses → mm 调用链
    CSES_CTRL --> CSES_SVC
    CSES_SVC --> CSES_CLIENT
    CSES_CLIENT -.HTTP/grpc 跨仓.-> MM_HANDLE_INC

    %% mm → cses 调用链
    MM_HANDLER --> MM_DEMO
    MM_DEMO --> MM_GRPC_CLIENT
    MM_GRPC_CLIENT -.grpc/HTTP 跨仓.-> CSES_COMP

    %% 索引层
    CSES_CLIENT -.java.ts<br/>抽 consumer Contract.-> MANIFEST_C2M
    CSES_COMP -.java.ts Micronaut<br/>抽 provider Contract.-> EXACT_LINK
    MM_GRPC_CLIENT -.manifest 显式声明.-> MANIFEST_M2C
    MM_HANDLE_INC -.go.ts BaseRoutes 不识别<br/>(B4 backlog) → manifest 兜底.-> MANIFEST_C2M

    MANIFEST_C2M --> BRIDGE_DB
    MANIFEST_M2C --> BRIDGE_DB
    EXACT_LINK --> BRIDGE_DB

    %% Pipeline 跑流程
    TRACE_CSES --> S2_HIT
    TRACE_MM --> S2_HIT
    S2_HIT --> CYPHER
    CYPHER -.读.-> BRIDGE_DB
    CYPHER --> S3_HIT
    S3_HIT --> MR_BIDIR

