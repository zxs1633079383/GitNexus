    subgraph S3_CY["💥 S3 · standard-cross-link 主路径"]
        CYPHER["MATCH (consumer:Contract)-[l:ContractLink]->(provider:Contract)<br/>WHERE consumer.repo=$primaryRepo<br/>  AND consumer.contractId=$cidEscaped<br/>  AND consumer.role='consumer'<br/>RETURN provider.repo, provider.symbolUid, l.matchType, l.confidence"]:::cypher
        S3_HIT["✅ partner 真命中<br/>matchType=manifest+exact, conf=1.00"]:::live
    end

    subgraph Pipeline["🎼 Pipeline Orchestrator (跨仓视角)"]
