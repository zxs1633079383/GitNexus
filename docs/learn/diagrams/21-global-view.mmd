    end

    subgraph BIZ["🏢 业务双仓"]
        CSES_BIZ[cses-java :3399<br/>Micronaut + paas grpc]
        MM_BIZ[mattermost :8065<br/>gorilla/mux + grpcx9]
    end

    subgraph OBS["🔭 可观测性"]
        OTEL[OpenTelemetry SDK<br/>HTTP+grpc 入出]
        JAEGER[Jaeger Query<br/>192.168.6.66:32281]
        PROM[Prometheus<br/>192.168.6.66:30090]
        OBSERVE[/observe skill<br/>巡检 → 建 issue]
    end

    subgraph GITLAB["🦊 GitLab git.yundiz.com"]
        REPO_GL[cses + mattermost project]
        ISSUES[Issues<br/>auto-detected + LIVE label]
        MRS[🚀 双向 6 LIVE MR<br/>cses !45/!47/!48<br/>mm !9/!10/!11]
        WH_OUT[GitLab webhook<br/>X-Gitlab-Token]
    end

    subgraph GNX["🧠 GitNexus 1.6.2 索引底座"]
        EVAL[gitnexus eval-server :4848<br/>tool/cypher tool/context tool/impact]
        IDX_CSES[(repos/cses/lbug<br/>107k symbols)]
        IDX_MM[(repos/mm/lbug<br/>160k symbols)]
        BRIDGE_DB[(groups/cses-mm/bridge.lbug<br/>1275 contracts / 54 ContractLink)]
    end

    subgraph WEBHOOK["⚙️ webhook server localhost:3034"]
        WS[start-webhook-server.ts<br/>SECRET + AUTOPR_LIVE + TOKEN_MAP]
        ORCH[🎼 Pipeline Orchestrator<br/>S2~S7 串联]
    end

    subgraph LLM["🤖 LLM patch R-14"]
        CLAUDE[claude -p 本机<br/>budget=$5]
        DEC{trace 有<br/>error+stacktrace?}
        PATCH[真 patch+assertThrows]
        ABORT[abort+诊断报告]
    end

    subgraph K8S["☸️ K8s Preview S6"]
        K8S_NS[ns gitnexus-preview-* 强制]
        TEST_RUN[junit XML pass/fail]
    end

    subgraph BACKLOG["📋 v1.2 backlog"]
        B1[B1 path camelCase ✅]
        B2[B2 Go path-only anchor ✅]
        B3[B3 manifest 扩 ✅]
        B5_FIX[Test_methodName.java fix ✅]
        B4[B4 BaseRoutes chain extractor 🟡]
    end

    %% 用户 → 业务
    USER --> CURL
    CURL --> CSES_BIZ
    CURL --> MM_BIZ
    CSES_BIZ <-. grpc paas .-> MM_BIZ

    %% 业务 → 可观测
    CSES_BIZ -.OTel.-> OTEL
    MM_BIZ -.OTel.-> OTEL
    OTEL --> JAEGER
    CSES_BIZ -.metrics.-> PROM
    MM_BIZ -.metrics.-> PROM

    %% 巡检 → issue
    JAEGER --> OBSERVE
    PROM --> OBSERVE
    OBSERVE -->|gitnexus:trace 块| ISSUES
    ISSUES --> WH_OUT
    WH_OUT --> WS
    WS --> ORCH

    %% Orchestrator 调底座
    ORCH -.调.-> EVAL
    EVAL -.读.-> IDX_CSES
    EVAL -.读.-> IDX_MM
    ORCH -.standard cross-link.-> BRIDGE_DB

    %% Orchestrator 调 LLM
    ORCH --> DEC
    DEC -->|有| CLAUDE
    DEC -->|无| ABORT
    CLAUDE --> PATCH
    CLAUDE --> ABORT

    %% S6 + S7
    PATCH --> K8S_NS
    ABORT --> K8S_NS
    K8S_NS --> TEST_RUN
    TEST_RUN -->|LIVE 三因子全过| MRS
    TEST_RUN -.dryRun.-> ISSUES

    %% 业务源 → 索引建立
    CSES_BIZ -.gitnexus analyze.-> IDX_CSES
    MM_BIZ -.gitnexus analyze.-> IDX_MM
    IDX_CSES -.bootstrap.-> BRIDGE_DB
    IDX_MM -.bootstrap.-> BRIDGE_DB

